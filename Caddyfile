# ============================================================================
# Zamorin Cafe ERP — Demo Caddyfile (auto-HTTPS via Let's Encrypt + sslip.io)
# No domain needed: https://<elastic-ip-with-dashes>.sslip.io
# ============================================================================
{
    # Email for Let's Encrypt (optional but recommended)
    # email demo@zamorin.cafe
}

:80, :443 {
    root * /srv/frontend
    file_server

    handle /api/* {
        reverse_proxy backend:4000
    }

    handle {
        try_files {path} /index.html
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    encode gzip zstd
}
